{
  "expo": {
    "name": "Recall",
    "slug": "recall",
    "version": "1.0.0",
    "scheme": "recall",
    "experiments": {
      "typedRoutes": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nourwalid.recall",
      "config": {
        "usesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nourwalid.recall",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Recall uses your microphone so you can speak a memory instead of typing it, and talk to it about what you have recorded."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Recall uses your photos to attach them to memories you log.",
          "cameraPermission": "Recall uses your camera to capture photos and videos for your memories."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Recall scans your photo library so it can place your photos on the days they were taken.",
          "savePhotosPermission": "Recall does not need to save photos, only read them.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Recall uses your location to tag where a memory happened, and to read where imported photos were taken."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Recall can use a contact's photo and name to fill in a person's profile, so you don't have to find one in your photos. It only looks when you ask it to."
        }
      ],
      "expo-notifications",
      "expo-image",
      "expo-asset",
      "expo-status-bar",
      "expo-sqlite",
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "36bac704-e0b1-4624-8c7d-7c5198f4dfe8"
      }
    }
  }
}
