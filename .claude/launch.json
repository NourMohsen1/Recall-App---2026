{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "recall-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "ear-animation",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "tools/ear-animation"
      ],
      "port": 8090
    },
    {
      "name": "brain-animation",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8091",
        "--directory",
        "assets/animations"
      ],
      "port": 8091
    }
  ]
}
