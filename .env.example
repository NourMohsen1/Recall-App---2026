# Recall talks to its own small server, never to OpenAI or DeepSeek
# directly. The provider keys live on that server (see server/) and must
# never appear here: anything EXPO_PUBLIC_* is written into the app bundle,
# which a tester can open.

# The deployed Worker, e.g. https://recall-keys.yourname.workers.dev
EXPO_PUBLIC_RECALL_API_URL=

# What the app presents to that server. Must match the RECALL_APP_TOKEN
# secret set on the Worker. Changing it there locks out every build that
# carries the old one — which is the point of it existing.
EXPO_PUBLIC_RECALL_APP_TOKEN=
